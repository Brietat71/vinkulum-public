#!/usr/bin/env bash
# Run the complete local CI, including Git operations in Lean dependencies.
set -euo pipefail
VINKULUM_HOOK_ROOT=$(git rev-parse --show-toplevel)
# Linked worktrees export GIT_DIR into hooks. Leaving it set makes Lake's
# nested Git commands inspect this repository instead of Mathlib's repository.
# https://git-scm.com/docs/githooks#_description
VINKULUM_HOOK_GIT_VARS=$(git rev-parse --local-env-vars)
while IFS= read -r VINKULUM_HOOK_GIT_VAR; do
  unset "$VINKULUM_HOOK_GIT_VAR"
done <<< "$VINKULUM_HOOK_GIT_VARS"
exec "$VINKULUM_HOOK_ROOT/ci/local.sh"
